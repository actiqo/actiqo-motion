# ── dependencies ──
node_modules/

# ── caches / build tooling ──
.cache/
.hyperframes/
.next/
.turbo/
.parcel-cache/
*.tsbuildinfo
.eslintcache

# ── temporary render output (frame dumps, scratch, intermediates) ──
**/frames/
**/tmp/
**/.tmp/
**/scratch/
**/render-cache/
**/*.tmp.png
**/*.partial.mp4
*.part

# ── temporary audio ──
**/audio-tmp/
*.tmp.wav

# ── logs ──
*.log
npm-debug.log*

# ── env / secrets (none exist today; never commit them) ──
.env
.env.*
*.pem
*.key

# ── OS / editor ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# ── licensed library audio (Artlist etc.): raw downloads stay local, never committed; only our mixes are ──
film02/production/audio/assets/
film02/production/audio/stems/

# ── GTM: raw paid generations and raw UI captures stay local; only selects + renders are committed ──
gtm/*/generations/raw/
gtm/*/ui/capture/
gtm/*/audio/assets/
# D01 final real-UI capture assets ARE kept (reviewed finals, not raw)
!gtm/d01-pickup/ui/capture/
gtm/d01-pickup/edit/assets/
gtm/*/edit/renders/
gtm/*/edit/sound/out/
